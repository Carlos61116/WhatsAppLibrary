# ============================================================================
# WhatsApp Notifications Library - Environment Variables Example
# ============================================================================
#
# Copy this file to .env and fill with your actual values
# .env will be loaded by Spring Boot automatically
# 
# IMPORTANT: Do NOT commit .env to git (add to .gitignore)
# ============================================================================

# ========== WhatsApp API Credentials ==========
# Obtain from: https://developers.facebook.com/

# Your WhatsApp Business Phone Number ID
WHATSAPP_PHONE_NUMBER_ID=1234567890123

# Your WhatsApp Cloud API Access Token
# Keep this SECRET - Never share or commit to git
WHATSAPP_ACCESS_TOKEN=EAAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: Webhook token for incoming message handling
WHATSAPP_WEBHOOK_TOKEN=your_webhook_verify_token

# ========== Application Config ==========

# Enable WhatsApp integration
WHATSAPP_ENABLED=true

# Default language for templates
WHATSAPP_DEFAULT_LANGUAGE=es

# API version to use
WHATSAPP_API_VERSION=v22.0

# Maximum retries for failed requests
WHATSAPP_MAX_RETRIES=3

# Delay between retries (milliseconds)
WHATSAPP_RETRY_DELAY_MS=1000

# ========== Spring Profiles ==========

# Active profiles (e.g., prod, dev, test)
SPRING_PROFILES_ACTIVE=prod

# ========== Logging ==========

# Log level for WhatsApp library
LOGGING_LEVEL_COM_WHATSAPP=INFO

# ============================================================================
# SETUP INSTRUCTIONS
# ============================================================================
#
# 1. Copy this file:
#    cp .env.example .env
#
# 2. Get credentials from Facebook Developer Console:
#    https://developers.facebook.com/
#    
#    a. Go to WhatsApp > API Setup
#    b. Copy "Phone Number ID"
#    c. Generate or copy an access token from System Users
#
# 3. Fill in the values above
#
# 4. Make sure .env is in .gitignore (already added)
#
# 5. Test your configuration:
#    mvn clean spring-boot:run
#
# ============================================================================
# SECURITY CHECKLIST
# ============================================================================
#
# [ ] .env is in .gitignore
# [ ] access-token is secure and rotated regularly
# [ ] Credentials are different for dev/prod
# [ ] Never share tokens in emails or Slack
# [ ] Use environment-specific tokens
# [ ] Monitor usage for suspicious activity
#
# ============================================================================
